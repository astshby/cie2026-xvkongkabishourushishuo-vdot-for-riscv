index e662cb1c..360c8c68 100644
--- a/src/isa/riscv64/system/intr.c
+++ b/src/isa/riscv64/system/intr.c
@@ -22,6 +22,29 @@
 
 void update_mmu_state();
 
+// The pinned Kunminghu V2 reports instruction bits for decode-time faults,
+// but zero for a configuration fault raised by the custom VIPU operation.
+// Model that architectural choice from the instruction/CSRs independently;
+// never copy tval or vector results from the DUT and never skip comparison.
+static word_t kks_illegal_instruction_tval(void) {
+#ifdef CONFIG_RVV
+  const uint32_t insn = cpu.instr;
+  if ((insn & 0xfc00707fU) == 0x0c000057U) {
+    const unsigned vd = (insn >> 7) & 31;
+    const unsigned vs1 = (insn >> 15) & 31;
+    const unsigned vs2 = (insn >> 20) & 31;
+    const unsigned align_mask = vtype->vlmul < 4 ? (1U << vtype->vlmul) - 1 : 0;
+    bool decode_fault = mstatus->vs == 0 || vtype->vill || vstart->val != 0 ||
+      ((vd | vs1 | vs2) & align_mask) != 0 || (!(insn & (1U << 25)) && vd == 0);
+#ifdef CONFIG_RVH
+    decode_fault |= cpu.v && vsstatus->vs == 0;
+#endif
+    return decode_fault ? insn : 0;
+  }
+#endif
+  return MUXDEF(CONFIG_TVAL_EX_II, cpu.instr, 0);
+}
