+// Difftest's v2 ABI supplies the DUT's exact flash bytes. The historical
+// filename ABI falls back to NEMU's newer preset boot code when given NULL,
+// which differs from this pinned Kunminghu V2 DUT before the workload starts.
+void difftest_load_flash_v2(const uint8_t *flash_bin, size_t f_size) {
+#ifdef CONFIG_HAS_FLASH
+  load_flash_contents(NULL);
+  assert(flash_bin != NULL && f_size <= get_flash_size());
+  memcpy(get_flash_base(), flash_bin, f_size);
+#endif
+}
