diff --git a/src/isa/riscv64/instr/rvv/vcompute.h b/src/isa/riscv64/instr/rvv/vcompute.h
index 2bcb6aae..df645052 100644
--- a/src/isa/riscv64/instr/rvv/vcompute.h
+++ b/src/isa/riscv64/instr/rvv/vcompute.h
@@ -19,6 +19,27 @@
 #include "vcompute_impl.h"
 #include "vcommon.h"
 
+// KKS dot16 is deliberately independent from RTL's balanced adder tree.
+// C uses a scalar loop as the golden reference for sixteen signed byte pairs.
+def_EHelper(vdot) {
+  require_vector(true);
+  if (vtype->vsew != 0 || vtype->vlmul != 0 || vl->val != 16 ||
+      vstart->val != 0 || s->vm != 1) {
+    longjmp_exception(EX_II);
+  }
+  int32_t sum = 0;
+  for (int i = 0; i < 16; ++i) {
+    const int32_t a = (int8_t)vreg_b(id_src1->reg, i);
+    const int32_t b = (int8_t)vreg_b(id_src2->reg, i);
+    sum += a * b;
+  }
+  // Read every source before writing: vd may alias either source register.
+  vreg_l(id_dest->reg, 0) = (uint32_t)sum;
+  vreg_l(id_dest->reg, 1) = 0;
+  vstart->val = 0;
+  vp_set_dirty();
+}
+
 def_EHelper(vadd) {
   ARITH(ADD, SIGNED)
 }
